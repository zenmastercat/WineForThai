+    "LEELAWUI.TTF,Leelawadee UI\0" \
+    "LEELAWAD.TTF,Leelawadee\0" \
+    "NotoSansThaiLooped-Regular.ttf,Noto Sans Thai Looped\0" \
+    "NotoSansThaiLooped.ttf,Noto Sans Thai Looped\0" \
+    "NotoSansThai-Regular.ttf,Noto Sans Thai\0" \
+    "NotoSansThai.ttf,Noto Sans Thai\0" \
+    "Loma.otf,Loma\0" \
+    "Loma.ttf,Loma\0" \
+    "Garuda.otf,Garuda\0" \
+    "Garuda.ttf,Garuda\0"
+
 static const char system_link_tahoma_sc[] =
     "SIMSUN.TTC,SimSun\0"
     "MINGLIU.TTC,PMingLiu\0"
@@ -1627,7 +1642,8 @@ static const char system_link_tahoma_sc[] =
     "MSJH.TTC,Microsoft JhengHei UI\0"
     "YUGOTHM.TTC,Yu Gothic UI\0"
     "MALGUN.TTF,Malgun Gothic\0"
-    "SEGUISYM.TTF,Segoe UI Symbol\0";
